{
  "name": "alert-video-studio",
  "version": "1.0.0",
  "description": "Alert Global Tech video studio: Remotion videos built from Supabase partner_content",
  "scripts": {
    "dev": "remotion studio",
    "fetch": "node --env-file=.env scripts/fetch-content.mjs",
    "mark-used": "node --env-file=.env scripts/mark-used.mjs",
    "validate-spec": "node scripts/validate-spec.mjs",
    "render": "remotion render AlertPromo-16x9",
    "typecheck": "tsc && node scripts/check-fonts.mjs",
    "upgrade": "remotion upgrade",
    "check-fonts": "node scripts/check-fonts.mjs",
    "vo": "node --env-file-if-exists=.env scripts/generate-vo.ts",
    "render:16x9": "node scripts/check-the-dot-assets.mjs && remotion render TheDot-16x9 \"out/Alert Global Tech - The Dot 16x9.mp4\"",
    "render:9x16": "node scripts/check-the-dot-assets.mjs && remotion render TheDot-9x16 \"out/Alert Global Tech - The Dot 9x16.mp4\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Henriquealert/ALERT-VIDEOS.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Henriquealert/ALERT-VIDEOS/issues"
  },
  "homepage": "https://github.com/Henriquealert/ALERT-VIDEOS#readme",
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/fonts": "4.0.537",
    "@remotion/layout-utils": "4.0.537",
    "@remotion/media-utils": "4.0.537",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.537",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "private": true,
  "type": "module"
}
